# task-definition 템플릿의 플레이스홀더(${...})에 채울 값 목록.
# 실제 값을 채운 파일(deploy.env 등)은 커밋하지 말 것. 배포 시점에만 주입한다.
# CD 파이프라인에서는 GitHub Secrets/Variables 또는 AWS에서 값을 주입한다.
#
# 템플릿 파일:
#   - task-definition.json       — 1차 사이드카(레거시, CD가 dev push 시 사용)
#   - task-definition-app.json   — 2차 app 전용
#   - task-definition-nginx.json — 2차 nginx 전용

# --- 계정/리전 ---
AWS_ACCOUNT_ID=
AWS_REGION=ap-northeast-2
ECR_REGISTRY=

# --- 이미지 태그 ---
APP_IMAGE_TAG=         # 예: v1 (또는 CD에서 커밋 SHA)
NGINX_IMAGE_TAG=

# --- IAM 역할 ARN ---
EXECUTION_ROLE_ARN=    # moplEcsTaskExecutionRole 의 ARN
TASK_ROLE_ARN=         # moplEcsTaskRole 의 ARN (S3 쓰기, app task-def 전용)

# --- DB / Redis ---
DB_URL=                # 예: jdbc:postgresql://<RDS 엔드포인트>:5432/mopl
DB_USERNAME=mopl
REDIS_HOST=            # ElastiCache 엔드포인트

# --- 관리자 계정 (평문) ---
ADMIN_EMAIL=
ADMIN_NAME=

# --- S3 (파일 스토리지) ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_S3_BASE_URL=       # CloudFront 도메인

# --- Kafka (Confluent Cloud, 평문 값) ---
KAFKA_BOOTSTRAP_SERVERS=   # 예: pkc-xxxxx.ap-northeast-2.aws.confluent.cloud:9092
KAFKA_CONSUMER_GROUP_ID=mopl-prod

# --- 메일 (비밀번호 재설정 발송, 평문 값) ---
EMAIL_ACCOUNT=            

# --- Secrets Manager ARN (참조 ARN) ---
DB_PASSWORD_SECRET_ARN=
JWT_SECRET_ARN=
ADMIN_PASSWORD_SECRET_ARN=
KAFKA_API_KEY_SECRET_ARN=
KAFKA_API_SECRET_SECRET_ARN=
EMAIL_PASSWORD_SECRET_ARN=
GOOGLE_CLIENT_ID_SECRET_ARN=
GOOGLE_CLIENT_SECRET_SECRET_ARN=
KAKAO_CLIENT_ID_SECRET_ARN=
KAKAO_CLIENT_SECRET_SECRET_ARN=

# --- 2차 배포: 서비스 분리 + Service Connect ---
SERVICE_CONNECT_NAMESPACE=mopl.local
APP_SERVICE_CONNECT_NAME=app           # app.mopl.local:8080
APP_SERVICE_NAME=mopl-app-service
NGINX_SERVICE_NAME=mopl-nginx-service
NGINX_TARGET_GROUP_NAME=mopl-nginx-tg
LEGACY_SERVICE_NAME=mopl-service
