# task-definition.json 템플릿의 플레이스홀더(${...})에 채울 값 목록.
# 실제 값을 채운 파일(deploy.env 등)은 커밋하지 말 것. 배포 시점에만 주입한다.
# CD 파이프라인에서는 GitHub Secrets/Variables 또는 AWS에서 값을 주입한다.

# --- 계정/리전 ---
AWS_ACCOUNT_ID=
AWS_REGION=ap-northeast-2
ECR_REGISTRY=          # 예: <AWS_ACCOUNT_ID>.dkr.ecr.ap-northeast-2.amazonaws.com

# --- 이미지 태그 ---
APP_IMAGE_TAG=         # 예: v1 (또는 CD에서 커밋 SHA)
NGINX_IMAGE_TAG=

# --- IAM 역할 ARN ---
EXECUTION_ROLE_ARN=    # moplEcsTaskExecutionRole 의 ARN
TASK_ROLE_ARN=         # moplEcsTaskRole 의 ARN (S3 쓰기)

# --- DB / Redis (평문, 비밀 아님) ---
DB_URL=                # 예: jdbc:postgresql://<RDS 엔드포인트>:5432/mopl
DB_USERNAME=mopl
REDIS_HOST=            # ElastiCache 엔드포인트

# --- 관리자 계정 (평문) ---
ADMIN_EMAIL=
ADMIN_NAME=

# --- S3 (파일 스토리지, #238 이후) ---
AWS_S3_BUCKET=
AWS_S3_REGION=ap-northeast-2
AWS_S3_BASE_URL=       # CloudFront 도메인

# --- Secrets Manager ARN (비밀 자체가 아니라 참조 ARN) ---
DB_PASSWORD_SECRET_ARN=
JWT_SECRET_ARN=
ADMIN_PASSWORD_SECRET_ARN=
