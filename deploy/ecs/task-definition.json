{
  "family": "mopl-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "runtimePlatform": {
    "cpuArchitecture": "ARM64",
    "operatingSystemFamily": "LINUX"
  },
  "executionRoleArn": "arn:aws:iam::882321772989:role/moplEcsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "app",
      "image": "882321772989.dkr.ecr.ap-northeast-2.amazonaws.com/mopl-app:v1",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" },
        { "name": "SERVER_PORT", "value": "8080" },
        { "name": "DB_URL", "value": "jdbc:postgresql://mopl-db.cb8u426m4qh3.ap-northeast-2.rds.amazonaws.com:5432/mopl" },
        { "name": "DB_USERNAME", "value": "mopl" },
        { "name": "REDIS_HOST", "value": "mopl-redis.gx6t57.ng.0001.apn2.cache.amazonaws.com" },
        { "name": "REDIS_PORT", "value": "6379" },
        { "name": "ADMIN_EMAIL", "value": "admin@mopl.com" },
        { "name": "ADMIN_NAME", "value": "admin" },
        { "name": "INGESTION_SCHEDULER_ENABLED", "value": "false" }
      ],
      "secrets": [
        { "name": "DB_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:882321772989:secret:mopl/db-password-Dn23SU" },
        { "name": "JWT_SECRET_KEY", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:882321772989:secret:mopl/jwt-secret-NeCyJ6" },
        { "name": "ADMIN_PASSWORD", "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:882321772989:secret:mopl/admin-password-65ebE8" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health | grep -q '\"status\":\"UP\"' || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 90
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mopl",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "app"
        }
      }
    },
    {
      "name": "nginx",
      "image": "882321772989.dkr.ecr.ap-northeast-2.amazonaws.com/mopl-nginx:v1",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "dependsOn": [
        { "containerName": "app", "condition": "HEALTHY" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/mopl",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "nginx"
        }
      }
    }
  ]
}
