{
  "title": "k6 부하테스트",
  "uid": "k6-load-testing",
  "editable": true,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "schemaVersion": 39,
  "tags": ["mopl", "k6", "load-test"],
  "templating": {
    "list": [
      {
        "name": "testid",
        "label": "Test ID",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "prometheus" },
        "query": "label_values(k6_vus, testid)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": false,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "현재 VUs",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus{testid=~\"$testid\"})",
          "legendFormat": "VUs"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "요청 처리율 (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "RPS"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "응답시간 p95",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "에러율",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_failed_rate{testid=~\"$testid\"})",
          "legendFormat": "실패율"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "요청 처리율 (req/s)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_http_reqs_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "RPS"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_iterations_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "iterations/s"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP 응답 시간 (avg / p90 / p95 / p99)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 4, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_duration_avg{testid=~\"$testid\"})",
          "legendFormat": "avg"
        },
        {
          "refId": "B",
          "expr": "max(k6_http_req_duration_p90{testid=~\"$testid\"})",
          "legendFormat": "p90"
        },
        {
          "refId": "C",
          "expr": "max(k6_http_req_duration_p95{testid=~\"$testid\"})",
          "legendFormat": "p95"
        },
        {
          "refId": "D",
          "expr": "max(k6_http_req_duration_p99{testid=~\"$testid\"})",
          "legendFormat": "p99"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "에러율 / 체크 성공률",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_failed_rate{testid=~\"$testid\"})",
          "legendFormat": "http 실패율"
        },
        {
          "refId": "B",
          "expr": "min(k6_checks_rate{testid=~\"$testid\"})",
          "legendFormat": "check 성공률"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "VUs",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_vus{testid=~\"$testid\"})",
          "legendFormat": "VUs"
        },
        {
          "refId": "B",
          "expr": "max(k6_vus_max{testid=~\"$testid\"})",
          "legendFormat": "VUs max"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "응답 시간 세부 단계 (p95)",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "s" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "max(k6_http_req_blocked_p95{testid=~\"$testid\"})",
          "legendFormat": "blocked"
        },
        {
          "refId": "B",
          "expr": "max(k6_http_req_connecting_p95{testid=~\"$testid\"})",
          "legendFormat": "connecting"
        },
        {
          "refId": "C",
          "expr": "max(k6_http_req_waiting_p95{testid=~\"$testid\"})",
          "legendFormat": "waiting (TTFB)"
        },
        {
          "refId": "D",
          "expr": "max(k6_http_req_receiving_p95{testid=~\"$testid\"})",
          "legendFormat": "receiving"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "데이터 송수신",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "fieldConfig": { "defaults": { "unit": "Bps" }, "overrides": [] },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(k6_data_sent_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "송신"
        },
        {
          "refId": "B",
          "expr": "sum(rate(k6_data_received_total{testid=~\"$testid\"}[1m]))",
          "legendFormat": "수신"
        }
      ]
    }
  ]
}
