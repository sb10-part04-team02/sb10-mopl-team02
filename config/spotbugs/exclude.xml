<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- dto/entity 패키지: 순수 데이터 객체이므로 내부 표현 노출 경고 제외 -->
    <Match>
        <Class name="~com\.team02\.mopl\.(.*\.)?(dto|entity)\..*"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- ErrorResponse: exception 패키지에 있으나 사실상 응답 DTO이므로 동일하게 제외 -->
    <Match>
        <Class name="com.team02.mopl.global.exception.ErrorResponse"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- dto/entity 패키지: 생성자에서 검증 예외를 던지는 것은 정상적인 방어 로직이므로 제외
         (JPA 엔티티는 프록시 때문에 final 불가, finalizer 공격은 Java 17 환경에서 사실상 무관) -->
    <Match>
        <Class name="~com\.team02\.mopl\.(.*\.)?(dto|entity)\..*"/>
        <Bug pattern="CT_CONSTRUCTOR_THROW"/>
    </Match>

    <!-- Spring 컴포넌트 레이어(controller/service/config): @RequiredArgsConstructor 가 생성한
         생성자가 DI 주입 협력 빈(싱글톤)을 필드에 그대로 저장하는 것은 정상 패턴이다.
         이 빈들은 데이터 보유 객체가 아니라 공유 재사용이 설계 의도이므로 방어적 복사 대상이 아니다 -> 오탐 제외 -->
    <Match>
        <Class name="~com\.team02\.mopl\.(.*\.)?(controller|service|config)\..*"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
  <!-- 위와 동일한 문제지만 패키지가 달라 따로 추가-->
    <Match>
        <Class name="com.team02.mopl.global.websocket.StompChannelInterceptor"/>

    <!-- 위와 동일한 문제지만 Registry는 위쪽의 패키지들과 다른 성질의 그룹인것 같아 따로 추가함-->
    <Match>
        <Class name="com.team02.mopl.domain.auth.jwt.JwtRegistry"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
