# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (cp .env.example .env)
# .env 파일은 절대 Git에 커밋하지 마세요

DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# OS 환경변수 권장
JWT_SECRET_KEY=

# Admin 설정
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# AWS
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_BASE_URL=

# TMDB API v4 Read Access Token (수집 기능용)
TMDB_ACCESS_TOKEN=