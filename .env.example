# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (cp .env.example .env)
# .env 파일은 절대 Git에 커밋하지 마세요

# ===== 필수 (기본값 없음 - 반드시 설정) =====
# 관리자 계정 자동 초기화용 (dev/prod 공통 필수)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# JWT 서명 키 (prod 필수 / dev는 임시 기본값 있으나 명시 권장, 최소 32바이트) - OS 환경변수 권장
JWT_SECRET_KEY=

# ===== DB (dev는 아래 기본값, prod는 필수) =====
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ===== 외부 API =====
# TMDB v4 Read Access Token
TMDB_ACCESS_TOKEN=
# The Sports DB 키 (미설정 시 무료 테스트 키 "123" 사용, 30 req/min)
SPORTSDB_API_KEY=

# ===== 인프라 (기본값으로 로컬 구동 가능) =====
SERVER_PORT=
REDIS_HOST=
REDIS_PORT=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP_ID=

# ===== 콘텐츠 수집 스케줄러 =====
# 기동 시 스케줄러 활성 여부 (dev 기본 false, prod 기본 true)
INGESTION_SCHEDULER_ENABLED=
# 수집 주기 cron (초 분 시 일 월 요일)
INGESTION_SCHEDULER_CRON=

# ===== 파일 스토리지 =====
# local 모드: 저장 파일/기본 썸네일 절대 URL 앞에 붙는 origin (dev)
STORAGE_PUBLIC_BASE_URL=
# s3 모드(prod): 자격증명은 ECS Task 역할에서 자동 탐색, 로컬 테스트 시에만 아래 키 사용
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_BASE_URL=
