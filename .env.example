# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (cp .env.example .env)
# .env 파일은 절대 Git에 커밋하지 마세요

DB_NAME=
DB_USERNAME=
DB_PASSWORD=

# OS 환경변수 권장
JWT_SECRET_KEY=

# Admin 설정
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=

# TMDB API v4 Read Access Token (수집 기능용)
TMDB_ACCESS_TOKEN=

# The Sports DB
SPORTSDB_API_KEY=

# 콘텐츠 수집 스케줄러
INGESTION_SCHEDULER_ENABLED=
INGESTION_SCHEDULER_CRON=
