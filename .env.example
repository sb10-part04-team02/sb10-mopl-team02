# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (cp .env.example .env)
# .env 파일은 절대 Git에 커밋하지 마세요

# ===== 필수 (기본값 없음 - 반드시 설정) =====
# 관리자 계정 자동 초기화용 (dev/prod 공통 필수)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
ADMIN_NAME=admin

# JWT 서명 키 (prod 필수 / dev는 임시 기본값 있으나 명시 권장, 최소 32바이트) - OS 환경변수 권장
JWT_SECRET_KEY=change-me-to-a-strong-secret-at-least-32-bytes

# ===== DB (dev는 아래 기본값, prod는 필수) =====
DB_URL=jdbc:postgresql://localhost:5432/mopl
DB_USERNAME=mopl
DB_PASSWORD=mopl

# ===== 외부 API =====
# TMDB v4 Read Access Token
TMDB_ACCESS_TOKEN=
# The Sports DB 키 (미설정 시 무료 테스트 키 "123" 사용, 30 req/min)
SPORTSDB_API_KEY=123

# ===== 인프라 (기본값으로 로컬 구동 가능) =====
SERVER_PORT=8080
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_CONSUMER_GROUP_ID=mopl-local

# ===== 콘텐츠 수집 스케줄러 =====
# 기동 시 스케줄러 활성 여부 (dev 기본 false, prod 기본 true)
INGESTION_SCHEDULER_ENABLED=false
# 수집 주기 cron (초 분 시 일 월 요일)
INGESTION_SCHEDULER_CRON=0 0 4 * * *

# ===== 파일 스토리지 =====
# 저장 파일/기본 썸네일 절대 URL 앞에 붙는 origin (dev)
STORAGE_PUBLIC_BASE_URL=http://localhost:8080
