# .env.example — 실제 값을 채워 .env 파일로 복사하세요 (cp .env.example .env)
# .env 파일은 절대 Git에 커밋하지 마세요

# ===== 필수 (기본값 없음 - 반드시 설정) =====
# 관리자 계정 자동 초기화용 (dev/prod 공통 필수)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=

# JWT 서명 키 (prod 필수 / dev는 임시 기본값 있으나 명시 권장, 최소 32바이트) - OS 환경변수 권장
JWT_SECRET_KEY=

# ===== DB (dev는 아래 기본값, prod는 필수) =====
DB_NAME=
DB_URL=
DB_USERNAME=
DB_PASSWORD=

# ===== 외부 API =====
# TMDB v4 Read Access Token
TMDB_ACCESS_TOKEN=
# The Sports DB 키 (미설정 시 무료 테스트 키 "123" 사용, 30 req/min)
SPORTSDB_API_KEY=

# ===== 인프라 (기본값으로 로컬 구동 가능) =====
SERVER_PORT=
REDIS_HOST=
REDIS_PORT=
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_CONSUMER_GROUP_ID=
# Kafka 스모크 테스트 활성화 (dev, 미설정 시 비활성)
KAFKA_SMOKE_TEST_ENABLED=
# Kafka 로그 appender SASL 인증 (prod 전용, dev 불필요)
KAFKA_API_KEY=
KAFKA_API_SECRET=

# ===== 콘텐츠 수집 스케줄러 =====
INGESTION_SCHEDULER_ENABLED=
INGESTION_SCHEDULER_CRON=
INGESTION_SCHEDULER_BACKFILL_CRON=

# ===== 파일 스토리지 =====
# local 모드: 저장 파일/기본 썸네일 절대 URL 앞에 붙는 origin (dev)
STORAGE_PUBLIC_BASE_URL=
# s3 모드(prod): 자격증명은 ECS Task 역할에서 자동 탐색, 로컬 테스트 시에만 아래 키 사용
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_S3_BASE_URL=

# ===== Email sender =====
EMAIL_ACCOUNT=
EMAIL_PASSWORD=

# ===== Discord =====
DISCORD_ALERT_WEBHOOK_URL=

# ===== 로깅 (Logstash) =====
# logback-spring.xml의 logstash appender 대상 (미설정 시 localhost:5000)
LOGSTASH_HOST=
LOGSTASH_PORT=

# ===== OAuth =====
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
